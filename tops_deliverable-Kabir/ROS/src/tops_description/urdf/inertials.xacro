<?xml version="1.0"?>
<!--
  Inertia formulas for simple solids.

  The Panda's own inertials are NOT here: they are Franka's official values,
  read straight from config/franka/*.yaml by panda_arm.xacro and
  panda_hand.xacro. These macros are for the scenery that has no published
  parameters (the table, the camera) and must still carry a physically
  valid inertia tensor — see the table's comment in tops_robot.urdf.xacro
  for what happens when one is not.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid cylinder about its centre, axis along z. -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <inertia ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
               izz="${mass * radius * radius / 2.0}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin" />
      <mass value="${mass}" />
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
               izz="${mass * (x*x + y*y) / 12.0}" />
    </inertial>
  </xacro:macro>

</robot>
